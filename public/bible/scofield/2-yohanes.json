        {
          "verse": 6,
          "text": "And this is love, that we walk after his commandments. This is the commandment, That, as ye have heard from the beginning, ye should walk in it.",
          "marked_text": "And this is love, that we walk after his commandments. This is the commandment, That, as ye have heard from the beginning, ye should walk in it.",
          "outlines": null,
          "footnotes": null
        },
        {
          "verse": 7,
          "text": "For many deceivers are entered into the world, who confess not that Jesus Christ is come in the flesh. This is a deceiver and an antichrist.",
          "marked_text": "For many deceivers are entered into the world<fn n=\"2\"/>, who confess not that Jesus Christ is come in the flesh. This is a deceiver and an antichrist<fn n=\"h\"/>.",
          "outlines": null,
          "footnotes": [
