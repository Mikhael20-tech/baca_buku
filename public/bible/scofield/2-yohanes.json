        {
          "verse": 10,
          "text": "If there come any unto you, and bring not this doctrine, receive him not into your house, neither bid him God speed:",
          "marked_text": "If there come any unto you, and bring not this doctrine, receive him not into your house, neither bid him God speed:<fn n=\"j\"/>",
